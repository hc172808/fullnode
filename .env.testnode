# ══════════════════════════════════════════════════════════════════
#  GYDS Chain Full Node — Test Node Configuration
#
#  Ephemeral isolated node for local development and CI testing.
#
#  Behaviour when GYDS_NODE_MODE=testnode:
#    - Data directory is wiped on every start (fresh chain from block 0)
#    - Block time is fixed at 5 seconds (GYDS_BLOCK_TIME is ignored)
#    - P2P is disabled — no network connectivity
#    - Dashboard and RPC bind to 127.0.0.1 (loopback only)
#
#  Usage:
#    set -a && source .env.testnode && set +a && go run . start
#  Or:
#    set -a && source .env.testnode && set +a && ./bin/gyds-fullnode start
# ══════════════════════════════════════════════════════════════════

# ── Chain Identity ─────────────────────────────────────────────
GYDS_CHAIN_ID=198282
GYDS_NETWORK_NAME="GYDS Chain"
GYDS_NODE_MODE=testnode
# Block time is overridden to 5s by testnode mode; this value is ignored.
GYDS_BLOCK_TIME=5

# ── Wallet ─────────────────────────────────────────────────────
# No wallet required for testnode — leave blank.
GYDS_WALLET_ADDRESS=
GYDS_WALLET_PRIVATE_KEY=

# ── Ports (loopback-only — not reachable externally) ───────────
GYDS_DASHBOARD_PORT=5000
GYDS_RPC_PORT=8545
GYDS_RPC_HOST=127.0.0.1
GYDS_WS_PORT=8546

# ── P2P (disabled in testnode mode) ────────────────────────────
GYDS_P2P_PORT=30303
GYDS_MAX_PEERS=0
# No bootstrap peers — test node is fully isolated.
GYDS_BOOTSTRAP_NODES=

# ── Storage ────────────────────────────────────────────────────
# Chain data is written to <GYDS_DATA_DIR>/test/ and wiped on each start.
GYDS_DATA_DIR=./data
GYDS_STORAGE_LIMIT_GB=1

# ── Firewall & Security ────────────────────────────────────────
# Firewall is not needed — the test node binds to loopback only.
GYDS_ENABLE_FIREWALL=false
GYDS_SSH_PORT=22

# ── Logging ────────────────────────────────────────────────────
# Use 'pretty' for coloured console output during development.
GYDS_LOG_LEVEL=debug
GYDS_LOG_FORMAT=pretty
