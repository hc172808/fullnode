# ══════════════════════════════════════════════════════════════════
#  GYDS Chain Full Node — Test Node Configuration
#
#  Ephemeral isolated node for local development and CI testing.
#
#  Behaviour when GYDS_NODE_MODE=testnode:
#    - Data directory (<GYDS_DATA_DIR>/test/) is wiped on every start
#    - Block time is fixed at 5 seconds (GYDS_BLOCK_TIME is ignored)
#    - P2P is disabled — completely disconnected from the main network
#    - Dashboard and RPC bind to 127.0.0.1 (loopback) only
#    - Uses a separate genesis (chain ID 31337) — MetaMask and ethers.js
#      immediately distinguish it from the live GYDS network (198282)
#
#  Usage:
#    set -a && source .env.testnode && set +a && go run . start
#  Or:
#    set -a && source .env.testnode && set +a && ./bin/gyds-fullnode start
#
#  Ports are intentionally different from the main node so both can run
#  at the same time on the same machine without conflict.
# ══════════════════════════════════════════════════════════════════

# ── Chain Identity ─────────────────────────────────────────────
# 31337 (0x7a69) — industry-standard dev chain ID (Hardhat / Anvil compatible)
# Completely separate from the live GYDS network (198282 / 0x3068a)
GYDS_CHAIN_ID=31337
GYDS_NETWORK_NAME="GYDS Test Network"
GYDS_NODE_MODE=testnode
# Block time is overridden to 5s internally by testnode mode.
GYDS_BLOCK_TIME=5

# ── Wallet ─────────────────────────────────────────────────────
# No wallet required for testnode — leave blank.
GYDS_WALLET_ADDRESS=
GYDS_WALLET_PRIVATE_KEY=

# ── Ports ──────────────────────────────────────────────────────
# Different from main node (5000 / 8545 / 8546) so both can run simultaneously.
GYDS_DASHBOARD_PORT=15000
GYDS_RPC_PORT=18545
GYDS_RPC_HOST=127.0.0.1
GYDS_WS_PORT=18546

# ── P2P (disabled in testnode mode) ────────────────────────────
GYDS_P2P_PORT=30304
GYDS_MAX_PEERS=0
GYDS_BOOTSTRAP_NODES=

# ── Storage ────────────────────────────────────────────────────
# Written to <GYDS_DATA_DIR>/test/ — wiped automatically on each start.
GYDS_DATA_DIR=./data
GYDS_STORAGE_LIMIT_GB=1

# ── Firewall & Security ────────────────────────────────────────
# Not needed — test node binds to 127.0.0.1 only.
GYDS_ENABLE_FIREWALL=false
GYDS_SSH_PORT=22

# ── Logging ────────────────────────────────────────────────────
# 'debug' + 'pretty' gives coloured, verbose output during development.
GYDS_LOG_LEVEL=debug
GYDS_LOG_FORMAT=pretty
