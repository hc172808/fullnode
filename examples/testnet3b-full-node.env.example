# Copy to .env on the full-node server. Replace both placeholders after the
# genesis host is provisioned and after you have collected its node ID.
GYDS_NETWORK=testnet3b
GYDS_CHAIN_ID=198284
GYDS_NETWORK_NAME="GYDS Testnet 3B"
GYDS_NODE_MODE=sync
GYDS_BLOCK_TIME=120

# Keep RPC local until you configure a secured HTTPS reverse proxy.
GYDS_DASHBOARD_ENABLED=true
GYDS_DASHBOARD_PORT=5000
GYDS_RPC_HOST=127.0.0.1
GYDS_RPC_PORT=8545
GYDS_P2P_PORT=30303
GYDS_P2P_ADVERTISE_HOST=REPLACE_WITH_FULL_NODE_REACHABLE_IP_OR_DNS
GYDS_P2P_ALLOW_PRIVATE_ADVERTISE=false

GYDS_BOOTSTRAP_NODES=REPLACE_WITH_GENESIS_REACHABLE_HOST:30303
GYDS_PEER_AUTH=true
# Add the genesis node ID after its first start.
GYDS_ALLOWED_NODES=

# This path is local to this server; never share it or the genesis node.key.
GYDS_DATA_DIR=/var/lib/gyds-fullnode-testnet3b
GYDS_STORAGE_LIMIT_GB=50
GYDS_ENABLE_FIREWALL=true
GYDS_ENABLE_FAIL2BAN=true
GYDS_SSH_PORT=22
GYDS_LOG_LEVEL=info
GYDS_LOG_FORMAT=json
