# ─────────────────────────────────────────────
# GYDS Full Node — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# Chain
GYDS_CHAIN_ID=13370
GYDS_NODE_MODE=full

# Networking
GYDS_RPC_PORT=8545
GYDS_RPC_HOST=0.0.0.0
GYDS_P2P_PORT=30303
GYDS_WS_PORT=8546

# Storage — chain state is persisted here across restarts
GYDS_DATA_DIR=/var/lib/gyds-fullnode

# Bootstrap peers (comma-separated tcp addresses)
# GYDS_BOOTSTRAP_NODES=tcp://node1.gydschain.io:30303

# Logging (trace|debug|info|warn|error)
GYDS_LOG_LEVEL=info
