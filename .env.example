# ══════════════════════════════════════════════════════════════════
#  GYDS Chain Full Node — Environment Configuration
#  Copy this file to .env and fill in your values, OR
#  use the web setup wizard at http://<host>:<dashboard_port>/setup
# ══════════════════════════════════════════════════════════════════

# ── Chain Identity ─────────────────────────────────────────────
GYDS_CHAIN_ID=198282
GYDS_NETWORK_NAME="GYDSChain"
GYDS_NODE_MODE=full
# Block production interval in seconds (default: 120)
GYDS_BLOCK_TIME=120

# ── Wallet ─────────────────────────────────────────────────────
# Your node operator wallet address (optional — used for display)
GYDS_WALLET_ADDRESS=
# Private key for signing (keep this SECRET — never share)
GYDS_WALLET_PRIVATE_KEY=

# ── RPC / API Ports ────────────────────────────────────────────
# Dashboard web UI port (separate from JSON-RPC)
GYDS_DASHBOARD_PORT=5000
GYDS_RPC_PORT=8545
GYDS_RPC_HOST=0.0.0.0
# WebSockets are served at /api/ws on the JSON-RPC listener.
# GYDS_WS_PORT is retained for compatibility with older deployments.
GYDS_WS_PORT=8546

# ── P2P Networking ─────────────────────────────────────────────
GYDS_P2P_PORT=30303
# Public IP or DNS name peers should dial (not 0.0.0.0 or 127.0.0.1)
GYDS_P2P_ADVERTISE_HOST=
GYDS_MAX_PEERS=25
# Comma-separated bootstrap peers
# GYDS_BOOTSTRAP_NODES=tcp://node1.gydschain.io:30303,tcp://node2.gydschain.io:30303

# ── Storage ────────────────────────────────────────────────────
# Absolute path where chain data (LevelDB) is stored
GYDS_DATA_DIR=/var/lib/gyds-fullnode
# Maximum storage allocation in GB (used by deploy.sh for monitoring)
GYDS_STORAGE_LIMIT_GB=50

# ── Firewall & Security ────────────────────────────────────────
# Optional bootstrap PIN. The setup wizard stores a hash under GYDS_DATA_DIR.
# Keep this file mode 0600 and remove the value after first initialization.
GYDS_DASHBOARD_PIN=
# Set to true to apply UFW rules during deploy.sh
GYDS_ENABLE_FIREWALL=true
# Optional SSH/RPC brute-force protection. Set false if fail2ban is unavailable.
GYDS_ENABLE_FAIL2BAN=true
# SSH port to keep open in the firewall
GYDS_SSH_PORT=22
# Comma-separated IPs to always allow through firewall (e.g. your VPN)
# GYDS_ALLOWED_IPS=1.2.3.4,5.6.7.8

# ── Logging ────────────────────────────────────────────────────
# trace | debug | info | warn | error
GYDS_LOG_LEVEL=info
# pretty (coloured console) | json (structured — recommended for production)
GYDS_LOG_FORMAT=json

# Public HTTPS origin used in wallet metadata and connection downloads.
# Example: https://rpc.example.com
# GYDS_EXTERNAL_URL=https://rpc.example.com
