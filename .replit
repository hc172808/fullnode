modules = ["go-1.21", "bash", "go-1.25"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GYDS_RPC_PORT=5000 go run . start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 30303
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "GYDS_RPC_PORT=5000 ./bin/gyds-litenode start"]
build = ["go", "build", "-o", "bin/gyds-litenode", "."]
