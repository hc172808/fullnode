modules = ["web", "go-1.21", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "GOTOOLCHAIN=local GYDS_DASHBOARD_PORT=5000 GYDS_RPC_PORT=8545 GYDS_NODE_MODE=full GYDS_DATA_DIR=./data go run . start"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8545
externalPort = 3002

[[ports]]
localPort = 15001
externalPort = 5000

[[ports]]
localPort = 18545
externalPort = 3001

[[ports]]
localPort = 18547
externalPort = 4200

[[ports]]
localPort = 30303
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "GYDS_RPC_PORT=5000 GYDS_NODE_MODE=full GYDS_DATA_DIR=/var/lib/gyds-fullnode ./bin/gyds-fullnode start"]
build = ["bash", "-c", "GOTOOLCHAIN=local go build -o bin/gyds-fullnode ."]
