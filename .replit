modules = ["web", "go-1.21", "bash", "python-base-3.13"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if [ -f .env ]; then set -a; . ./.env; set +a; fi; GOTOOLCHAIN=local GYDS_DASHBOARD_PORT=${GYDS_DASHBOARD_PORT:-5000} GYDS_RPC_PORT=${GYDS_RPC_PORT:-8545} GYDS_DATA_DIR=./data go run . start"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8545
externalPort = 3002

[[ports]]
localPort = 15001
externalPort = 5000

[[ports]]
localPort = 15011
externalPort = 6000

[[ports]]
localPort = 15021
externalPort = 8000

[[ports]]
localPort = 15500
externalPort = 8008

[[ports]]
localPort = 18545
externalPort = 3001

[[ports]]
localPort = 18547
externalPort = 4200

[[ports]]
localPort = 18557
externalPort = 5173

[[ports]]
localPort = 18567
externalPort = 6800

[[ports]]
localPort = 30303
externalPort = 3000

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "if [ -f /var/lib/gyds-fullnode/.env ]; then set -a; . /var/lib/gyds-fullnode/.env; set +a; fi; GYDS_RPC_PORT=${GYDS_RPC_PORT:-5000} GYDS_DATA_DIR=${GYDS_DATA_DIR:-/var/lib/gyds-fullnode} ./bin/gyds-fullnode start"]
build = ["bash", "-c", "GOTOOLCHAIN=local go build -o bin/gyds-fullnode ."]
